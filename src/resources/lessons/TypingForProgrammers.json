      "Description": "Recursive Factorial Function in JavaScript",
      "Lines": [{
        "Line_01": "function factorial(n) {",
        "Line_02": "  if (n === 0) {",
        "Line_03": "    return 1;",
        "Line_04": "  } else {",
        "Line_05": "    return n * factorial(n - 1);",
        "Line_06": "  }",
        "Line_07": "}",
        "Line_08": "let result = factorial(5);",
        "Line_09": "console.log(result);"
      }]
    },
